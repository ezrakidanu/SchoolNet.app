# Local demonstration database (SQLite); use a Neon PostgreSQL URL in deployment.
DATABASE_URL=sqlite:///./schoolnet_dev.db
# Replace with a cryptographically random value before any non-local use.
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Trusted one-time bootstrap only (python -m app.seed_admin)
SCHOOLNET_SCHOOL_NAME=Example Secondary School
SCHOOLNET_SCHOOL_SLUG=example-school
SCHOOLNET_ADMIN_NAME=School Administrator
SCHOOLNET_ADMIN_EMAIL=admin@example.edu
SCHOOLNET_ADMIN_PASSWORD=replace-with-a-strong-password
